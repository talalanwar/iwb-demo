# Database Configuration
# Default: SQLite file in project root (sqlite:///./app.db)
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./app.db

# JWT Authentication Configuration
# IMPORTANT: Change JWT_SECRET_KEY to a strong random value in production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Port Configuration
# These are used by start.sh to find available ports
# The script will increment if a port is in use
BACKEND_PORT=9000
FRONTEND_PORT=5173

# CORS Origins (comma-separated)
# Add your frontend domain(s) here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
